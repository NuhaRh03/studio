
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Allow users to read their own data from the 'data' subcollection.
    // The {userId} wildcard must match the uid of the authenticated user.
    match /devices/{userId}/data/{docId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false; // Keep writes restricted.
    }

    // Allow authenticated users to read predictions.
    match /predictions/{predictionId} {
      allow read: if request.auth != null;
      allow write: if false; // Restrict writes to backend processes.
    }
  }
}
