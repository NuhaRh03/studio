
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Allow authenticated users to read from the 'data' subcollection of any device document.
    // This is more specific and correctly matches the application's query path.
    match /devices/{deviceId}/data/{docId} {
      allow read: if request.auth != null;
      allow write: if false; // Keep writes restricted for now.
    }

    // Allow authenticated users to read predictions.
    match /predictions/{predictionId} {
      allow read: if request.auth != null;
      allow write: if false; // Restrict writes to backend processes.
    }
  }
}
