
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Allow any authenticated user to read user documents for this demo.
    match /users/{userId} {
      allow read: if request.auth != null;
      // Writes should only come from your backend script, so deny client writes.
      allow write: if false; 
    }

    // Allow any authenticated user to read from the 'realtime_data' subcollection.
    match /users/{userId}/realtime_data/{docId} {
      allow read: if request.auth != null;
      // Writes should only come from your Python script, so deny client writes.
      allow write: if false;
    }

    // Allow authenticated users to read predictions.
    match /predictions/{predictionId} {
      allow read: if request.auth != null;
      allow write: if false; // Restrict writes to backend processes.
    }
  }
}
