
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Allow authenticated users to read device data.
    // In a production app, you would restrict this to the user who owns the device.
    match /devices/{deviceId}/{subcollection}/{docId} {
      allow read: if request.auth != null;
      allow write: if false; // Keep writes restricted
    }

    // Allow authenticated users to read the realtime data stream for the dashboard
    match /devices/device_python/{any_child=**} {
      allow read: if request.auth != null;
    }

    // Allow authenticated users to read predictions.
    match /predictions/{docId} {
      allow read: if request.auth != null;
      allow write: if false; // Restrict writes to backend processes
    }
  }
}
